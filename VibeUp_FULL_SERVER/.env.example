# Server-only secrets. Never put these into the APK.
VIBEUP_YANDEX_TOKEN=PASTE_YANDEX_OAUTH_TOKEN_HERE
VIBEUP_ADMIN_KEY=SET_A_LONG_RANDOM_ADMIN_KEY
VIBEUP_AI_KEY=PASTE_OPENAI_API_KEY_HERE
VIBEUP_AI_MODEL=gpt-4o-mini
PORT=3000
# Docker Compose sets this automatically; do not point it at the phone.
VIBEUP_RECOGNIZER_URL=http://recognizer:8765/recognize
